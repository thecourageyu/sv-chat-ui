# Which API style to use: "anthropic" or "openai".
# Leave unset to infer from which API key is configured (OpenAI when only OPENAI_API_KEY is set).
LLM_API=anthropic

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

SYSTEM_PROMPT=You are a helpful, concise assistant.
DB_PATH=data/app.db
ALLOW_REGISTRATION=true

# ---- Embeddings (for summary/memory vector search) ----
# Your embedding API must serve POST {EMBEDDING_BASE_URL}/v1/embeddings with a body
# { input: string | string[], model } and return { data: [{ index, embedding: number[] }] }.
# See src/lib/server/embeddings.js for the full spec.
EMBEDDING_BASE_URL=http://localhost:11434     # e.g. an Ollama / OpenAI-compatible embeddings endpoint
EMBEDDING_MODEL=text-embedding-3-small        # or e.g. nomic-embed-text on Ollama
EMBEDDING_API_KEY=                            # optional; sent as `Authorization: Bearer <key>` when set
EMBEDDING_DIM=1536                            # must match the model's output dimension
