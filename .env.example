# Which API style to use: "anthropic" or "openai".
# Leave unset to infer from which API key is configured (OpenAI when only OPENAI_API_KEY is set).
#LLM_API=anthropic
LLM_API=openai
LLM_API_KEY=sk-ant-...
LLM_MODEL=slm
#LLM_BASE_URL=http://localhost:8082/v1
LLM_BASE_URL=http://localhost:9487/v1
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_MAX_TOKENS=4096

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=slm
# OPENAI_BASE_URL=http://localhost:8082/v1

# ---- Dedicated LLM for summarisation / memory extraction (optional) ----
# Leave all MEMORY_* unset to use the chat LLM above. Set a MEMORY_API_KEY or
# MEMORY_MODEL to dedicate a separate model/API to those tasks. MEMORY_API
# selects the provider style ("anthropic" | "openai"); otherwise LLM_API is used.
# MEMORY_API=anthropic
MEMORY_API=openai
MEMORY_API_KEY=sk-ant-...
MEMORY_MODEL=qwen3.6-40b-special
MEMORY_BASE_URL=http://localhost:8080/v1

# ---- Embeddings (for summary/memory vector search) ----
# Your embedding API must serve POST {EMBEDDING_BASE_URL}/v1/embeddings with a body
# { input: string | string[], model } and return { data: [{ index, embedding: number[] }] }.
# See src/lib/server/embeddings.js for the full spec.
EMBEDDING_BASE_URL=http://localhost:8081     # e.g. an Ollama / OpenAI-compatible embeddings endpoint
EMBEDDING_MODEL=intfloat/multilingual-e5-small        # or e.g. nomic-embed-text on Ollama
EMBEDDING_API_KEY=yzk-embedding-key                            # optional; sent as `Authorization: Bearer <key>` when set
EMBEDDING_DIM=384                            # must match the model's output dimension


#SYSTEM_PROMPT=You are a helpful, concise assistant.
ChatSymbol=☘
DB_PATH=data/app.db
ALLOW_REGISTRATION=true
